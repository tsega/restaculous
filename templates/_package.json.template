{
  "name": "{{appName}}-api",
  "version": "0.0.1",
  "description": "{{appDescription}}",
  "type": "module",
  "repository": {
    "type": "{{repositoryType}}",
    "url": "{{repositoryAddress}}"
  },
  "main": "app.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "mocha",
    "dev": "nodemon app.js",
    "start": "node app.js",
    "build-docs": "apidoc -i ./routes -o ./docs",
    "prettier": "prettier --write *.js **/*.js",
    "eslint": "eslint --fix  './**/*.js'"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2"
  },
  "devDependencies": {
    "apidoc": "^1.2.0",
    "chai": "^4.4.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.1.1",
    "mocha": "^10.4.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4"
  },
  "apidoc": {
    "name":"{{appName}}-api",
    "version": "0.0.1",
    "description": "{{appDescription}}",
    "title": "{{appName}}-api Documentation"
  },
  "prettier": {
    "printWidth":80,
    "tabWidth":2,
    "useTabs":false,
    "semi":true,
    "singleQuote":false,
    "trailingComma":"none",
    "bracketSpacing":true,
    "requirePragma":false,
    "insertPragma":false,
    "proseWrap":"preserve"
  }
}
