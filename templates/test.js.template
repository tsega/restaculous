import assert from "node:assert/strict";
import { describe, it } from "node:test";
import jwt from "jsonwebtoken";
import request from "supertest";

import app from "../src/app.js";
import { JWT_KEY } from "../src/config/index.js";
import {{modelName}} from "../src/models/{{modelNameToLower}}.js";

const authorization = {{authToken}};
const sampleDocument = {
{{modelFields}}
};

describe("{{modelName}} endpoints", () => {
{{#post}}
  it("creates a {{modelNameToLower}}", async () => {
    const response = await request(app)
      .post("/{{modelNamePluralToLower}}")
      .set("Authorization", authorization)
      .send(sampleDocument)
      .expect(201);

    assert.ok(response.body._id);
  });
{{/post}}
{{#get}}
  it("gets a {{modelNameToLower}} by ID", async () => {
    const existing = await {{modelName}}.create(sampleDocument);
    const response = await request(app)
      .get(`/{{modelNamePluralToLower}}/${existing.id}`)
      .set("Authorization", authorization)
      .expect(200);

    assert.equal(response.body._id, existing.id);
  });
{{/get}}
{{#search}}
  it("searches {{modelNamePluralToLower}}", async () => {
    await {{modelName}}.create(sampleDocument);
    const response = await request(app)
      .get("/{{modelNamePluralToLower}}/search")
      .set("Authorization", authorization)
      .expect(200);

    assert.ok(Array.isArray(response.body.result));
    assert.equal(typeof response.body.options.total, "number");
  });
{{/search}}
{{#put}}
  it("updates a {{modelNameToLower}}", async () => {
    const existing = await {{modelName}}.create(sampleDocument);
    const response = await request(app)
      .put(`/{{modelNamePluralToLower}}/${existing.id}`)
      .set("Authorization", authorization)
      .send(sampleDocument)
      .expect(200);

    assert.equal(response.body._id, existing.id);
  });
{{/put}}
{{#delete}}
  it("deletes a {{modelNameToLower}}", async () => {
    const existing = await {{modelName}}.create(sampleDocument);
    const response = await request(app)
      .delete(`/{{modelNamePluralToLower}}/${existing.id}`)
      .set("Authorization", authorization)
      .expect(200);

    assert.equal(response.body._id, existing.id);
  });
{{/delete}}
});
